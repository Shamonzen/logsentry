# Copy to .env (git-ignored). Lab only: this account exists solely in the `target` container.
# Deliberately weak so the milestone 11 scenarios can crack it; never reuse it anywhere.
LAB_PASSWORD=sunshine1

# Optional, for running `logsentry tail` on your own server (the lab's tail has no network).
# HIGH and CRITICAL alerts are pushed to this ntfy topic. Anyone who knows the topic name can
# read it, so pick a long random one. Not loaded automatically: export it or use a systemd
# EnvironmentFile.
# LOGSENTRY_NTFY_URL=https://ntfy.sh/logsentry-change-me-to-something-random

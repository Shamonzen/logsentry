# LogSentry daily summary: one phone message with the last 24 hours of alerts.
# Started every morning by logsentry-summary.timer. Send one now with:
#   sudo systemctl start logsentry-summary
[Unit]
Description=LogSentry daily summary push
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=logsentry
Group=logsentry
# reads the database only, but SQLite's WAL mode still writes its -shm file here
StateDirectory=logsentry
EnvironmentFile=-/etc/logsentry/logsentry.env
ExecStart=/opt/logsentry/.venv/bin/logsentry summary --db /var/lib/logsentry/logsentry.db
Environment=PYTHONDONTWRITEBYTECODE=1

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
